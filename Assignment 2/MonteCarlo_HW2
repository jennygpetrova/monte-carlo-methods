function fibonacci_generator(N, x0, x1)
    sample = [x0, x1] 
    M = 2^31
    for k in 1:(N-2)
        x2 = mod(x1 + x0, M) # lagged Fibonacci generator
        push!(sample, x2) # collect each generated sample
        x0 = x1
        x1 = x2
    end
    return sample / M # return entire pseudorandom sequence
end

function ks_test(sample::Array)
    N=length(sample)
    order=sort(sample)
    dplus=0
    dminus=0
    # compute KS-statistic -> take maximum difference in empirical and theoretical cdf values
    for k in 1:N
        dplus=max(dplus,k/N-order[k]) 
    end
    for k in 1:N
        dminus=max(dminus,order[k]-(k-1)/N)
    end
    return max(dplus,dminus) # return the KS-statistic
end

