function runup_test(N, seed)
    x0 = seed
    runups = Int[]
    run_length = 1
    for i in 0:N
        x1 = mod(8*x0, 67100963) # multiplicative congruential generator
        if x1 > x0
            run_length += 1 # length of run i
        else
            push!(runups, run_length)
            run_length = 1 # reset count when run-up ends (next value < previous value)
        end
        x0 = x1
    end
    push!(runups, run_length)
    return runups # return all run-ups in sequence
end

function runup_statistic(runups, a, b, N)
    # count number of run-ups of length 1-5 or length 6 or more
    u = [
        count(==(1), runups),
        count(==(2), runups),
        count(==(3), runups),
        count(==(4), runups),
        count(==(5), runups),
        count(x -> x >= 6, runups)
    ]
    print("\n1: ", u[1], "\n2: ", u[2], "\n3: ", u[3], "\n4: ", u[4], "\n5: ", u[5], "\n6: ", u[6], "\n")
    r = 0.0
    for j in 1:6
        for i in 1:6
            r += (u[i] - N*b[i]) * (u[j] - N*b[j]) * a[i, j] # compute run-up statistic w/ pre-defined coefficients
        end
    end
    return r / N
end

